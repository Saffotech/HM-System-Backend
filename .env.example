ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1200
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_ROOT=uploads
ENVIRONMENT=development

# Feature rollout
CLIENT_DOCUMENTS_ENABLED=false
EMAIL_RECOVERY_ENABLED=false

# ZeptoMail
